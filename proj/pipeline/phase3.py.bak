from __future__ import annotations
from db.repository import Repository
from nlp.nli.nli_classifier import NLIClassifier
from matching.claim_matcher import ClaimMatcher
from aerf.scorer import AERFScorer
from aerf.adaptive_updater import AdaptiveAERFUpdater
from graph.evidence_graph import sync_evidence_graph
from evolution.timeline_builder import build_evolution
from gaps.gap_detector import detect_gaps
from explainability.explanation_builder import build_claim_explanation

class Phase3Pipeline:
    def __init__(self, repository: Repository, nli_model='MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli', similarity=.55, entity=.15, nli_conf=.60, weights=None, entity_alignment_version='v2'):
        self.repo=repository
        self.nli=NLIClassifier(nli_model)
        self.matcher=ClaimMatcher(self.nli,similarity,entity,nli_conf,entity_alignment_version=entity_alignment_version)
        self.scorer=AERFScorer(repository,weights=weights or None,version='aerf-v1')
        self.updater=AdaptiveAERFUpdater(repository,self.scorer)
    def run(self, paper_id=None):
        self.repo.ensure_phase3_schema()
        claims=self.repo.get_claims_for_paper(paper_id) if paper_id is not None else self.repo.get_all_claims()
        # Candidate generation is corpus-wide; only cross-paper pairs are eligible.
        all_claims=self.repo.get_all_claims(); matched=0; relations={'supports':0,'contradicts':0,'neutral':0,'uncertain':0}
        affected=set()
        if paper_id is None:
            # Corpus-wide: every unordered cross-paper pair is visited exactly
            # once via the "earlier claim in the list as a" convention.
            candidate_pairs=((a,b) for i,a in enumerate(all_claims) for b in all_claims[i+1:] if a['paper_id']!=b['paper_id'])
        else:
            # Single-paper: this paper's claims against every OTHER paper's
            # claims, regardless of claim_id/list order. The all_claims[i+1:]
            # convention above relies on `a` ranging over the whole corpus in
            # claim_id order; restricting `a` to one paper while keeping that
            # same "only look forward" rule silently drops every other paper
            # whose claims have a LOWER claim_id than this paper's (e.g. a
            # paper ingested and Phase-2'd earlier), since those claims can
            # only ever appear as `b`, never as `a`, once `a` is restricted.
            target_claims=[c for c in all_claims if c['paper_id']==paper_id]
            other_claims=[c for c in all_claims if c['paper_id']!=paper_id]
            candidate_pairs=((a,b) for a in target_claims for b in other_claims)
        # ---- PERFORMANCE FIX ----
        # The old loop did ~6 SQLite connections per claim pair (embeddings,
        # entities, relations) BEFORE the cheap cosine gate, i.e. O(N*M*6)
        # DB round-trips. Everything is now loaded ONCE into memory and the
        # similarity gate is applied before any NLI/DB work.
        import numpy as np
        emb={}; ents={}; rels={}
        for c in all_claims:
            cid=c['claim_id']; v=self.repo.get_claim_embedding(cid)
            if v is None: continue
            n=np.linalg.norm(v); emb[cid]=(v/n) if n else v
            ents[cid]=self.repo.get_claim_entities(cid); rels[cid]=self.repo.get_claim_relations(cid)
        # pairs already decided in an earlier run are not re-scored (no repeated NLI)
        done=set()
        if hasattr(self.repo,'get_all_claim_pair_keys'):
            done=self.repo.get_all_claim_pair_keys()
        sim_gate=float(self.matcher.similarity_threshold)
        for a,b in candidate_pairs:
            ia,ib=a['claim_id'],b['claim_id']
            if ia not in emb or ib not in emb: continue
            if (min(ia,ib),max(ia,ib)) in done: continue
            if float(np.dot(emb[ia],emb[ib]))<sim_gate: continue   # cheap gate first
            d=self.matcher.match(a,b,ents[ia],ents[ib],rels[ia],rels[ib],emb[ia],emb[ib])
            if d is None: continue
            self.repo.upsert_claim_pair({'claim_a_id':d.claim_a_id,'claim_b_id':d.claim_b_id,'cosine_similarity':d.cosine_similarity,'nli_label':d.nli_label,'nli_confidence':d.nli_confidence,'entity_overlap_score':d.entity_overlap_score,'validated_as':d.validated_as,'nli_entailment':d.nli_entailment,'nli_contradiction':d.nli_contradiction,'nli_neutral':d.nli_neutral,'relation_alignment_score':d.relation_alignment_score,'matching_method':d.method,'entity_alignment':sorted(set(x['text'] for x in ents[ia]) & set(x['text'] for x in ents[ib])),'nli_model_name':self.nli.model_name})
            matched+=1; relations[d.validated_as]=relations.get(d.validated_as,0)+1; affected.update((d.claim_a_id,d.claim_b_id))
        # Establish a baseline for every claim, then adaptively update evidence-connected claims.
        for c in all_claims:
            if self.repo.get_current_aerf(c['claim_id']) is None:
                result=self.scorer.score(c['claim_id'])
                self.repo.store_aerf_score(c['claim_id'],result.score,result.factors,result.weights_version)
        changed=self.updater.recompute(affected,trigger_paper_id=paper_id,trigger_claim_id=None) if affected else []
        edges=sync_evidence_graph(self.repo); evolution=build_evolution(self.repo); gaps=detect_gaps(self.repo)
        for cid in (affected or {c['claim_id'] for c in claims}): build_claim_explanation(self.repo,cid)
        return {'paper_id':paper_id,'claims_considered':len(claims),'candidate_relationships_persisted':matched,'validated_relationships':relations,'adaptive_score_changes':len(changed),'graph_edges_synced':edges,'evolution_snapshots':len(evolution),'research_gaps':len(gaps)}

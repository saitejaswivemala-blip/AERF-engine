            "No AERF score records available."

        )



    else:



        # -------------------------

        # SCORE COLUMN

        # -------------------------



        score_col = first_existing(

            scores.columns,

            [

                "score",

                "aerf_score",

                "reliability_score",

            ],

        )



        if score_col:



            scores[score_col] = pd.to_numeric(

                scores[score_col],

                errors="coerce",

            )



            valid_scores = scores[

                score_col

            ].dropna()



            c1, c2, c3 = st.columns(3)



            with c1:

                st.metric(

                    "Average Reliability",

                    f"{valid_scores.mean():.3f}",

                )



            with c2:

                st.metric(

                    "Highest",

                    f"{valid_scores.max():.3f}",

                )



            with c3:

                st.metric(

                    "Lowest",

                    f"{valid_scores.min():.3f}",

                )



        st.divider()



        # -------------------------

        # FACTORS

        # -------------------------



        st.subheader(

            "Reliability Dimensions"

        )



        factor_names = [

            "Source",

            "Methodology",

            "Corroboration",

            "Contradiction Pressure",

            "Temporal Relevance",

            "Semantic Confidence",

            "Provenance",

        ]



        st.write(

            "AERF combines evidence characteristics across multiple dimensions."

        )



        factor_cols = []



        for name in factor_names:



            possible = [

                name.lower().replace(" ", "_"),

                name.lower().replace(" ", ""),

            ]



            found = first_existing(

                scores.columns,

                possible,

            )



            if found:

                factor_cols.append(found)



        if factor_cols:



            factor_data = scores[

                factor_cols

            ].apply(

                pd.to_numeric,

                errors="coerce",

            ).mean()



            factor_data.index = [

                x.replace("_", " ").title()

                for x in factor_data.index

            ]



            st.bar_chart(

                factor_data

            )



        st.divider()



        # -------------------------

        # CLAIM MAPPING

        # -------------------------



        if (

            not claims.empty

            and "claim_id" in scores.columns

        ):



            claim_map = dict(

                zip(

                    claims["claim_id"],

                    claims["text"],

                )

            )



            scores["Claim"] = scores[

                "claim_id"

            ].map(claim_map)



        # -------------------------

        # SCORE TABLE

        # -------------------------



        st.subheader(

            "Claim Reliability Scores"

        )



        st.dataframe(

            scores,

            use_container_width=True,

            hide_index=True,

        )



        # -------------------------

        # ADAPTIVE HISTORY

        # -------------------------



        if not history.empty:



            st.divider()



            st.subheader(

                "Adaptive Reliability Changes"

            )



            if (

                "old_score" in history.columns

                and "new_score" in history.columns

            ):



                chart = history[

                    [

                        "old_score",

                        "new_score",

                    ]

                ].copy()



                st.line_chart(

                    chart

                )



            st.dataframe(

                history,

                use_container_width=True,

                hide_index=True,

            )






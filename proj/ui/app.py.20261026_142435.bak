            claims = claims[

                claims["text"]

                .astype(str)

                .str.contains(

                    search,

                    case=False,

                    na=False,

                )

            ]



        # -------------------------

        # PAPER FILTER

        # -------------------------



        if "paper_id" in claims.columns:



            papers = read_table("papers")



            if not papers.empty:



                paper_id_col = first_existing(

                    papers.columns,

                    ["paper_id", "id"],

                )



                title_col = first_existing(

                    papers.columns,

                    [

                        "title",

                        "paper_title",

                        "name",

                    ],

                )



                if paper_id_col and title_col:



                    paper_map = dict(

                        zip(

                            papers[paper_id_col],

                            papers[title_col],

                        )

                    )



                    claims["Paper"] = claims[

                        "paper_id"

                    ].map(paper_map)



        # -------------------------

        # SUMMARY

        # -------------------------



        st.metric(

            "Claims Found",

            len(claims),

        )



        st.divider()



        # -------------------------

        # CLAIM CARDS

        # -------------------------



